{
  "name": "my-filter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "biome ci && next build",
    "vercel-build": "next build && pnpm run db:migrate",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:db": "tsx e2e/setup-db.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:delete-user": "tsx scripts/delete-user.ts",
    "check-updates": "npm-check-updates"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.104.5",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "better-auth": "1.7.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "10.2.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "jsdom": "^30.1.3",
    "npm-check-updates": "^23.1.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
