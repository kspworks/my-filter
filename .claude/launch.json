{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "my-filter",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "my-filter (invite-only)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev", "--port", "3001"],
      "port": 3001,
      "env": {
        "INVITE_ONLY": "true",
        "BETTER_AUTH_URL": "http://localhost:3001"
      }
    }
  ]
}
